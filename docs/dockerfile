FROM fr2.icr.io/ap26882-prod/market-place/ap12287/toolbox/docker-images/core-images/node-22:v2026.07.24 AS build
# Root package.json is read by vite.config.ts (../package.json)
RUN mkdir -p /app/run-manager-front && chown -R coder:coder /app
USER coder
WORKDIR /app/run-manager-front
COPY --chown=coder package.json /app/package.json
COPY --chown=coder run-manager-front/package.json run-manager-front/package-lock.json ./
RUN npm ci
COPY --chown=coder run-manager-front/ ./
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM fr2.icr.io/ap26882-prod/market-place/ap12287/toolbox/docker-images/core-images/nginx:v2026.07.24
COPY --chown=101:101 run-manager-front/nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=101:101 --from=build /app/run-manager-front/dist /usr/share/nginx/html
# Numeric UID so Kubernetes runAsNonRoot can verify it
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget -qO- http://localhost:8080/ || exit 1
